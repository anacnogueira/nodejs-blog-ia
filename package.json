{
  "name": "blog-ia",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --env-file=.env --env-file=.env.local --watch src/index.js",
    "lint": "oxlint src tests",
    "format": "oxfmt src tests",
    "format:check": "oxfmt --check src tests",
    "test": "node --test",
    "dev:infra:up": "docker-compose up -d && npm run dev",
    "env:setup": "cp .env.example .env.local",
    "local:setup": "npm run env:setup && npm run infra:up && npm run migrate:up",
    "infra:up": "docker-compose up -d",
    "infra:down": "docker-compose down",
    "migrate:up": "node --env-file-if-exists=.env --env-file-if-exists=.env.local ./node_modules/postgrator-cli/index.js migrate",
    "migrate:down": "node --env-file-if-exists=.env --env-file-if-exists=.env.local ./node_modules/postgrator-cli/index.js migrate --to=0",
    "prepare": "lefthook install"
  },
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@mastra/core": "^1.85.0",
    "nanoid": "^6.0.2",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "lint-staged": "^17.6.1",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "postgrator-cli": "^10.0.0"
  },
  "lint-staged": {
    "*.{js,mjs,cjs}": [
      "oxlint --fix",
      "oxfmt"
    ]
  }
}
